# Server-seitig. Niemals mit NEXT_PUBLIC_ benennen.
# Lokales Modell (llama.cpp, OpenAI-kompatible API). Wenn gesetzt, wird statt OpenAI dieser Endpunkt genutzt.
LLM_BASE_URL=http://192.168.188.22:8080/v1
LLM_API_KEY=local

# OpenRouter für den Hilfe-Chat – nur aktiv, wenn in lib/settings.ts MODEL_ENDPOINT_LOCAL = false steht
OPENROUTER_API_KEY=
# Optional: anderes OpenRouter-Modell als Standard (openai/gpt-6-luna)
# OPENROUTER_CHAT_MODEL=openai/gpt-6-luna

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EXTRACTION_MODEL=gpt-5.5
OPENAI_SEARCH_MODEL=gpt-5.5
OPENAI_MODE=auto
MAIL_MODE=dev
APP_BASE_URL=http://localhost:3000
AUTO_CANCEL_EMAIL=false
